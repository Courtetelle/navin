{
  "name": "navin",
  "version": "1.0.0",
  "description": "NavIn: offline logbook for sailing on Lake Geneva and at sea, installable as a PWA",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "vite build",
    "check-types": "tsc --noEmit",
    "dev": "vite",
    "eslint": "eslint .",
    "eslint-fix": "eslint . --fix",
    "prettier": "prettier --check .",
    "prettier-write": "prettier --write .",
    "smoke": "node scripts/smoke/smoke.ts",
    "preview": "vite preview",
    "test": "npm run test-only && npm run check-types && npm run eslint && npm run prettier",
    "test-only": "vitest run --coverage"
  },
  "dependencies": {
    "@preact/signals-react": "^3.12.0",
    "immer": "^11.2.9",
    "leaflet": "^1.9.4",
    "leaflet-rotate": "^0.5.3",
    "pmtiles": "^4.5.0",
    "protomaps-leaflet": "^5.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^4.1.12",
    "@zakodium/tsconfig": "^1.0.5",
    "diff": "^9.0.0",
    "eslint": "^9.39.5",
    "eslint-config-zakodium": "^20.1.0",
    "pixelmatch": "^8.0.0",
    "playwright-core": "^1.64.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.12"
  }
}
